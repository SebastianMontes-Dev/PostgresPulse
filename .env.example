# ============================================================
# PostgresPulse - Variables de entorno
# Copia este archivo a .env y ajusta los valores localmente.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Base de datos propia de la aplicacion (pulse-db) ---
PULSE_DB_URL=jdbc:postgresql://localhost:5432/pulse_db
PULSE_DB_USER=pulse
PULSE_DB_PASSWORD=pulse

# --- Cifrado de credenciales de las fuentes analizadas ---
# Clave AES-256-GCM. Debe tener al menos 32 bytes (caracteres).
# En produccion: genera una propia con un gestor de secretos.
PULSE_CRYPTO_KEY=cambiar-por-una-clave-propia-de-minimo-32-caracteres

# --- Programacion de analisis automatico (Fase 6) ---
# Cron estandar: 6 campos. Deshabilitado por defecto.
PULSE_SCHEDULER_ENABLED=false
PULSE_SCHEDULER_CRON=0 0 * * * *

# --- Credenciales del administrador inicial (solo se usan una vez, para
# crear la primera fila en la tabla `usuarios`; cambiarlas despues no
# resetea la contrasena ya elegida via el panel de gestion de usuarios) ---
PULSE_ADMIN_USER=admin
PULSE_ADMIN_PASSWORD=admin

# --- Firma de los JWT de sesion ---
# Al menos 16 caracteres. En produccion: genera uno propio con un gestor
# de secretos, igual que PULSE_CRYPTO_KEY.
PULSE_JWT_SECRET=cambiar-por-un-secreto-jwt-propio
# Minutos de validez del token antes de tener que volver a iniciar sesion.
PULSE_JWT_EXPIRACION_MINUTOS=480

# --- Sembrado automatico de la fuente de demostracion (target-demo) ---
# Solo tiene efecto con docker-compose.yml (target-demo existe). En un
# despliegue real contra fuentes de produccion, dejar en false.
PULSE_DEMO_SEED=true

# --- Formato de logs por consola ---
# Vacio = formato legible por defecto de Spring Boot. "ecs" = JSON
# estructurado, pensado para agregadores de logs (no depende de correr en
# Docker).
PULSE_LOG_FORMAT=

# --- Alertas de salud (docs/DEPLOYMENT.md #5.5) ---
# El umbral que dispara una alerta se configura por fuente
# (POST/PUT /api/v1/fuentes), no aqui. Estas variables solo habilitan y
# configuran los canales de envio, comunes a toda la instancia.
PULSE_ALERTS_EMAIL_ENABLED=false
PULSE_ALERTS_EMAIL_FROM=
PULSE_ALERTS_EMAIL_TO=
PULSE_SMTP_HOST=
PULSE_SMTP_PORT=587
PULSE_SMTP_USER=
PULSE_SMTP_PASSWORD=
PULSE_ALERTS_SLACK_WEBHOOK_URL=
PULSE_ALERTS_PAGERDUTY_ROUTING_KEY=
