{
  "title": "PostgresPulse - Vista operativa",
  "uid": "postgrespulse-operativo",
  "tags": ["postgrespulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Analisis por resultado",
      "description": "postgrespulse.analisis.total, tag resultado=exito|error",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(postgrespulse_analisis_total[5m])) by (resultado)",
          "legendFormat": "{{resultado}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Analisis por disparador",
      "description": "postgrespulse.analisis.total, tag disparado_por=MANUAL|PROGRAMADO",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(postgrespulse_analisis_total[5m])) by (disparado_por)",
          "legendFormat": "{{disparado_por}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duracion promedio de analisis exitosos",
      "description": "postgrespulse.analisis.duracion (solo analisis exitosos; sin buckets de percentiles expuestos, se calcula el promedio con sum/count)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(postgrespulse_analisis_duracion_seconds_sum[5m]) / rate(postgrespulse_analisis_duracion_seconds_count[5m])) * 1000",
          "legendFormat": "duracion promedio"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fuentes registradas",
      "description": "postgrespulse.fuentes.registradas (gauge)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "postgrespulse_fuentes_registradas"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memoria JVM (heap)",
      "description": "jvm_memory_used_bytes / jvm_memory_max_bytes, area=heap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "usada"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "maxima"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pool de conexiones Hikari",
      "description": "hikaricp_connections_active / idle / max (pulse-db, la BD propia de la app)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "activas"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_max",
          "legendFormat": "maximas"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Throughput HTTP",
      "description": "http_server_requests_seconds_count, por codigo de estado",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
